<%- include("./partials/header.ejs") %>
<main class="container">
    <form method="GET" action="/filter-students" class="filter">
        <label for="academic_year">Academic Year:</label>
        <select name="academic_year" id="academic_year" required>
            <option value="">Select Year</option>
            <% academicYears.forEach(function(year) { %>
                <option value="<%= year.id %>" <%= year.id == academicYearSelected ? 'selected' : '' %>><%= year.year %></option>
            <% }); %>
        </select>
    
        <label for="batch">Batch:</label>
        <select name="batch" id="batch">
            <option value="">Select Batch</option>
            <% batches.forEach(function(batch) { %>
                <option value="<%= batch.id %>" <%= batch.id == batchSelected ? 'selected' : '' %>><%= batch.batch_name %></option>
            <% }); %>
        </select>

        <label for="call_type">Call Type:</label>
        <select name="call_type" id="call_type">
            <option value="">Select Call Type</option>
            <option value="fees" <%= callTypeSelected == 'fees' ? 'selected' : '' %>>Fees</option>
            <option value="review" <%= callTypeSelected == 'review' ? 'selected' : '' %>>Review</option>
        </select>
    
        <button type="submit">Filter</button>
    </form>
    
    <div class="card student-list">
        <h2 class="card-title">
            Students List
            <span><button id="export-btn" class="btn">Export to Excel</button></span>
        </h2>
        
        <% if (students && students.length > 0) { %>
            <table id="studentsTable" data-sort-order="asc">
                <thead>
                    <tr>
                        <th class="sortable asc" onclick="sortTable(0)">Sr.No</th>
                        <th class="sortable" onclick="sortTable(1)">Name</th>
                        <th class="sortable" onclick="sortTable(2)">Contact</th>
                        <% if (callTypeSelected === 'fees') { %>
                            <th class="sortable" onclick="sortTable(3)">Last Payment Date</th>
                            <th class="sortable" onclick="sortTable(4)">Fees Paid</th>
                            <th class="sortable" onclick="sortTable(5)">Fees Pending</th>
                            <th class="sortable" onclick="sortTable(6)">Closing Amount</th>
                            <th class="sortable" onclick="sortTable(7)">Actual Amount</th>
                            <th class="sortable" onclick="sortTable(8)">Next Installment Date</th>
                            <th>Call Done</th>
                        <% } else if (callTypeSelected === 'review') { %>
                            <th class="sortable" onclick="sortTable(3)">Academic Year</th>
                            <th class="sortable" onclick="sortTable(4)">Batch</th>
                            <th>Call Done</th>
                        <% } else { %>
                            <th class="sortable" onclick="sortTable(3)">Academic Year</th>
                            <th class="sortable" onclick="sortTable(4)">Batch</th>  
                            <th class="sortable" onclick="sortTable(5)">Last Payment Date</th>
                            <th class="sortable" onclick="sortTable(6)">Fees Paid</th>
                            <th class="sortable" onclick="sortTable(7)">Fees Pending</th>
                            <th class="sortable" onclick="sortTable(8)">Closing Amount</th>
                            <th class="sortable" onclick="sortTable(9)">Actual Amount</th>
                            <th class="sortable" onclick="sortTable(10)">Next Installment Date</th>
                        <% } %>
                        <th>Edit</th>
                    </tr>
                </thead>
                <tbody>
                    <% students.forEach(function(student, index) { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td><%= student.name %></td>
                            <td><%= student.contact %></td>
                            <% if (callTypeSelected === 'fees') { %>
                                <td><%= new Date(student.last_payment_date).toISOString().split('T')[0] %></td>
                                <td><%= student.fees_paid %></td>
                                <td><%= student.fees_pending %></td>
                                <td><%= student.closing_amount %></td>
                                <td><%= student.actual_amount %></td>
                                <td><%= student.next_installment_date ? new Date(student.next_installment_date).toISOString().split('T')[0] : 'Full Fees Paid' %></td>
                                <td><input type="checkbox" 
                                    name="call_done" 
                                    data-student-id="<%= student.id %>" 
                                    data-call-type="<%= callTypeSelected %>"
                                    <%= student.call_done ? 'checked' : '' %> 
                                    onchange="saveCallDone(this)">
                                </td>
                            <% } else if (callTypeSelected === 'review') { %>
                                <td><%= student.year %></td>
                                <td><%= student.batch_name || 'N/A' %></td>
                                <td><input type="checkbox" 
                                    name="call_done" 
                                    data-student-id="<%= student.id %>" 
                                    data-call-type="<%= callTypeSelected %>"
                                    <%= student.call_done ? 'checked' : '' %> 
                                    onchange="saveCallDone(this)">
                                </td>
                            <% } else { %>
                                <td><%= student.year %></td>
                                <td><%= student.batch_name || 'N/A' %></td>
                                <td><%= new Date(student.last_payment_date).toISOString().split('T')[0] %></td>
                                <td><%= student.fees_paid %></td>
                                <td><%= student.fees_pending %></td>
                                <td><%= student.closing_amount %></td>
                                <td><%= student.actual_amount %></td>
                                <td><%= student.next_installment_date ? new Date(student.next_installment_date).toISOString().split('T')[0] : 'Full Fees Paid' %></td>
                            <% } %>
                            <td><form action="/students/<%= student.id %>/edit" method="get"><button class="edit-btn">Edit</button></form></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        <% } else { %>
            <div class="no-students-message">
                <p>No students available for the selected criteria. Please try different filters or add new students.</p>
            </div>
        <% } %>
    </div>
</main>
<%- include("./partials/footer.ejs") %>